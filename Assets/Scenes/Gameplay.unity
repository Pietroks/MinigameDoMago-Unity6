  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 17
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "INIMIGOS (GUIA OFICIAL):\n  \u2022 GOBLIN COMUM: 1 HP | 1 Ponto | Move-se aleatoriamente atacando com facas.\n  \u2022 GOBLIN FUGITIVO: 2 HP | 2 Pontos | Ao ser atingido, salta e foge em disparada acelerada!\n  \u2022 GOBLIN DOURADO: 3 HP | 5 Pontos | Mais rapido e agressivo com escudo. Vale mais pontos!\n  \u2022 GOBLIN FANTASMA: 4 HP | 3 Pontos | Teleporte dimensional instantaneo atraves de portais ao tomar dano.\n\nSISTEMA DE COMBOS & MULTIPLICADORES:\n  \u2022 1-4 abates: x1  |  5-9 abates: x2  |  10-19 abates: x3  |  20+ abates: x4!\n  \u2022 Errar um tiro no vazio ou deixar um goblin fugir QUEBRA O COMBO imediatamente!\n\nBONUS DE PRECISAO:\n  \u2022 HEADSHOT: Acertos no topo da cabeca concedem +1 Ponto Imediato!\n\nCOMANDOS:\n  \u2022 [LMB]: Disparo  |  [RMB]: Tiro Forte (Dano 3 - Recarga 3s)\n  \u2022 [R]: Recarregar Mana (Pente de 8)  |  [ESC / P]: Pausar"
