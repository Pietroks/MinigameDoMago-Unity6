MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 598350067}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 13
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "INIMIGOS (GUIA OFICIAL DOS GOBLINS):\n  \u2022 GOBLIN COMUM: 1 HP | 1 Ponto | Move-se atacando com facas.\n  \u2022 GOBLIN FUGITIVO: 2 HP | 2 Pontos | Ao sofrer dano, salta em disparada veloz!\n  \u2022 GOBLIN DOURADO: 3 HP | 5 Pontos | Mais rapido com escudo impenetravel temporario.\n  \u2022 GOBLIN FANTASMA: 4 HP | 3 Pontos | Teleporta atraves de portais misticos ao tomar dano.\n\nOS 5 GRANDES CHEFES (A CADA 10 GOBLINS):\n  \u2022 \U0001F451 10\xBA: GRANDE GOBLIN: 15 HP | +25 Pts | Golpe sismico e investida brutal.\n  \u2022 \U0001F525 20\xBA: XAM\xC3 DO CAOS: 25 HP | +50 Pts | Projeteis de fogo e erupcoes em area.\n  \u2022 \U0001F52E 30\xBA: FEITICEIRO ESPECTRAL: 35 HP | +100 Pts | Teleporte, invisibilidade e servos.\n  \u2022 \U0001FA78 40\xBA: LORDE CARMESIM: 50 HP | +150 Pts | Cetro sismico, orbe de sangue e rito carmesim.\n  \u2022 \u2694\uFE0F 50\xBA: GOBLIN REI SUPREMO: 80 HP | +500 Pts | Abalo colossal, magma triplo! DERROTAR = VITORIA!\n\nARSENAL MAGICO & COMBOS:\n  \u2022 \U0001F525 [LMB] NORMAL: 1 Dano | \U0001F4A5 [1/Q] ARCANO: 3 Dano | \u2744\uFE0F [2/E] GELO: Congela 2.5s\n  \u2022 \u26A1 [3/F] RELAMPAGO: Corrente eletrica | \U0001F300 [4/C] AREA: Explosao 2.5m (2 Dano)\n  \u2022 \U0001F3AF HEADSHOT: +1 Ponto! | \U0001F525 COMBOS: Multiplicadores x1..x4!\n\nSISTEMA DE RANK (S / A / B / C / D):\n  \u2022 Calculado por: Mortes, Precis\xE3o, Tempo, Escapados, Maior Combo e Feiti\xE7os Fortes!"
